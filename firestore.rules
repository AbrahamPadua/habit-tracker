rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function getSpace(spaceId) {
      return get(/databases/$(database)/documents/spaces/$(spaceId));
    }

    function spaceExists(spaceId) {
      return exists(/databases/$(database)/documents/spaces/$(spaceId));
    }

    function isSpaceMember(spaceData, me, other) {
      return ('members' in spaceData)
        && spaceData.members is list
        && me in spaceData.members
        && other in spaceData.members;
    }

    function hasMatchingSpace(myData, otherData, me, other) {
      return ('spaceId' in myData)
        && myData.spaceId != null
        && myData.spaceId is string
        && ('spaceId' in otherData)
        && myData.spaceId == otherData.spaceId
        && spaceExists(myData.spaceId)
        && isSpaceMember(getSpace(myData.spaceId).data, me, other);
    }

    function isLinked(me, other) {
      return isSignedIn()
        && userExists(me)
        && userExists(other)
        && hasMatchingSpace(getUser(me).data, getUser(other).data, me, other);
    }

    function isValidUserDoc(data) {
      return data.keys().hasOnly(['name', 'sharing', 'spaceId'])
        && data.keys().hasAll(['name', 'sharing', 'spaceId'])
        && ('name' in data) && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && ('sharing' in data) && data.sharing is bool
        && ('spaceId' in data) && (data.spaceId is string || data.spaceId == null);
    }

    function isValidItemDoc(data) {
      return ('type' in data) && data.type in ['goal', 'habit', 'task']
        && ('title' in data) && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && ('private' in data) && data.private is bool
        && ('createdOn' in data) && data.createdOn is string;
    }

    function isValidSpaceCreate(data) {
      return data.keys().hasOnly(['members', 'createdAt'])
        && data.keys().hasAll(['members', 'createdAt'])
        && data.members == [request.auth.uid];
    }

    function isValidSpaceJoin() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && resource.data.members.size() == 1
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.members == [resource.data.members[0], request.auth.uid];
    }

    function isValidSpaceUnlink() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.auth.uid in resource.data.members
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0] in resource.data.members;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isLinked(request.auth.uid, uid);
      allow create, update: if isOwner(uid) && isValidUserDoc(request.resource.data);
      allow delete: if isOwner(uid);

      match /items/{itemId} {
        allow read: if isOwner(uid)
          || (
            isLinked(request.auth.uid, uid)
            && getUser(uid).data.get('sharing', false) == true
            && resource.data.private == false
          );
        allow create, update: if isOwner(uid) && isValidItemDoc(request.resource.data);
        allow delete: if isOwner(uid);
      }
    }

    match /spaces/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && isValidSpaceCreate(request.resource.data);
      allow update: if isSignedIn() && (isValidSpaceJoin() || isValidSpaceUnlink());
      allow delete: if false;
    }
  }
}
